# Never commit real values to this file.
COGNI_DB_PATH=data/cogni_routine.sqlite3
COGNI_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
COGNI_COOKIE_SECURE=0
COGNI_DEMO_MODE=false
COGNI_PUBLIC_URL=https://your-public-https-url.example
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Configure both server-side before enabling Agent features.
GEMINI_LLM1_API_KEY=
GEMINI_LLM1_MODEL=gemini-2.5-flash
GEMINI_LLM2_API_KEY=
GEMINI_LLM2_MODEL=gemini-2.5-flash
